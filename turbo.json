{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "format": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["RABBITMQ_IMAGE"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "generate:asyncapi:json": {
      "dependsOn": ["^build"],
      "outputs": ["asyncapi.json"]
    },
    "generate:asyncapi:yaml": {
      "dependsOn": ["^build"],
      "outputs": ["asyncapi.yaml"]
    },
    "@amqp-contract/docs#build": {
      "dependsOn": [
        "@amqp-contract/asyncapi#build",
        "@amqp-contract/client#build",
        "@amqp-contract/contract#build",
        "@amqp-contract/core#build",
        "@amqp-contract/testing#build",
        "@amqp-contract/worker#build"
      ],
      "outputs": [".vitepress/dist/**"],
      "env": ["DOCS_BASE", "DOCS_VERSIONS"]
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
