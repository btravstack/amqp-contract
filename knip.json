{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@amqp-contract/testing"]
    },
    "examples/basic-order-processing-contract": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "examples/*": {
      "project": ["src/**/*.ts"]
    },
    "docs": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    }
  },
  "ignore": [".github/scripts/inject-docs-version-nav.ts"],
  "ignoreDependencies": [
    "typedoc-plugin-markdown",
    "@btravstack/typedoc",
    "@btravstack/oxlint",
    "@btravstack/lefthook"
  ]
}
